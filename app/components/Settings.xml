<?xml version="1.0" encoding="utf-8" ?>
<!-- Settings: wallpaper (automatic or a pinned photo, chosen from a picker of
     the Pi's photos) and how often Home changes photo. Saved on the TV. -->
<component name="Settings" extends="Group">
  <interface>
    <field id="relay" type="string" />
    <!-- Set to a photo name to use its blurred copy as the backdrop -->
    <field id="photo" type="string" onChange="onPhoto" />
    <field id="opened" type="bool" alwaysNotify="true" onChange="onOpened" />
    <!-- Outputs to HomeScene -->
    <field id="closed" type="bool" alwaysNotify="true" />
    <!-- Set by HomeScene once the sheet is hidden: frees its images -->
    <field id="released" type="bool" alwaysNotify="true" onChange="release" />
    <field id="changed" type="assocarray" alwaysNotify="true" />
  </interface>

  <script type="text/brightscript" uri="Settings.brs" />

  <children>
    <Poster id="backdrop" width="1920" height="1080" />
    <Rectangle id="veil" width="1920" height="1080" color="0x080C0E66" />

    <Label id="title" translation="[140, 72]" color="0xF6F1E7FF">
      <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="56" />
    </Label>
    <Label id="subtitle" translation="[142, 146]" color="0xF6F1E7AA">
      <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="28" />
    </Label>

    <!-- Page 1: setting rows -->
    <Group id="rows" translation="[112, 232]">
      <Poster id="rowPlate" uri="pkg:/images/plate_row.png" width="1056" height="112" />
    </Group>

    <!-- Page 2: wallpaper picker -->
    <Group id="picker" visible="false">
      <Group id="cells">
        <Poster id="pickPlate" uri="pkg:/images/plate_pick.png" />
      </Group>
    </Group>
    <Label id="message" translation="[140, 260]" color="0xF6F1E7CC">
      <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="34" />
    </Label>

    <Animation id="rowAnim" duration="0.18" easeFunction="outCubic">
      <Vector2DFieldInterpolator id="rowTo" key="[0.0, 1.0]" fieldToInterp="rowPlate.translation" />
    </Animation>
    <Animation id="pickAnim" duration="0.18" easeFunction="outCubic">
      <Vector2DFieldInterpolator id="pickTo" key="[0.0, 1.0]" fieldToInterp="pickPlate.translation" />
    </Animation>
    <Animation id="scrollAnim" duration="0.24" easeFunction="outCubic">
      <Vector2DFieldInterpolator id="scrollTo" key="[0.0, 1.0]" fieldToInterp="cells.translation" />
    </Animation>
  </children>
</component>
