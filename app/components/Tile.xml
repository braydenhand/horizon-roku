<?xml version="1.0" encoding="utf-8" ?>
<!-- One app in the dock: a white mark over its name, or just the name in
     larger type for services without a usable mark. -->
<component name="Tile" extends="Group">
  <interface>
    <field id="app" type="assocarray" onChange="onApp" />
    <field id="highlighted" type="bool" value="false" onChange="onState" />
    <!-- Picked up for moving: bigger and fully bright -->
    <field id="lifted" type="bool" value="false" onChange="onState" />
    <!-- Horizontal position in the dock; changes after the first slide in -->
    <field id="slotX" type="float" onChange="onSlotX" />
  </interface>

  <script type="text/brightscript" uri="Tile.brs" />

  <children>
    <Group id="slot">
      <Group id="body" opacity="0.84" scaleRotateCenter="[144, 100]">
        <Poster id="mark" />
        <Label id="label" width="288" translation="[0, 128]" horizAlign="center" color="0xF6F1E7FF">
          <Font role="font" uri="pkg:/fonts/Inter-Medium.ttf" size="34" />
        </Label>
        <Label id="name" width="288" height="200" horizAlign="center" vertAlign="center" color="0xF6F1E7FF">
          <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="40" />
        </Label>
      </Group>
    </Group>
    <Animation id="anim" duration="0.18" easeFunction="outCubic">
      <FloatFieldInterpolator id="fadeTo" key="[0.0, 1.0]" fieldToInterp="body.opacity" />
      <Vector2DFieldInterpolator id="liftTo" key="[0.0, 1.0]" fieldToInterp="body.translation" />
      <Vector2DFieldInterpolator id="scaleTo" key="[0.0, 1.0]" fieldToInterp="body.scale" />
    </Animation>
    <Animation id="slide" duration="0.22" easeFunction="outCubic">
      <Vector2DFieldInterpolator id="slideTo" key="[0.0, 1.0]" fieldToInterp="slot.translation" />
    </Animation>
  </children>
</component>
