' Home: photo background with glass surfaces rendered by the watcher on the Pi
' (the Roku can't blur live), a dock of apps with a gliding focus plate, and an
' inputs circle that stretches into a pill. Geometry comes from
' pkg:/data/apps.json, generated by build.py.

sub init()
    m.top.backgroundColor = "0x0B0F1AFF"
    data = ParseJson(ReadAsciiFile("pkg:/data/apps.json"))
    m.layout = data.layout
    m.catalog = data.catalog
    m.apps = loadDock(data.apps)
    m.inputs = data.inputs
    m.relay = data.relay
    if m.relay = invalid then m.relay = ""

    for each id in ["bgA", "bgB", "content", "clock", "clockShadow", "info", "infoShadow", "dockGlass", "shelf", "track", "plate", "fadeL", "fadeR", "mini", "miniGlass", "tvIcon", "pill", "pillGlass", "pillContent", "segPlate", "utils", "allApps", "settings", "layerSettings", "bgFadeTo", "rotateTimer", "preload", "keyTrap", "layerAnim", "layerContent", "layerSheet", "saverAnim", "saverFade", "saverLayer", "plateAnim", "plateTo", "trackAnim", "trackTo", "segAnim", "segTo", "pillAnim", "pillScale", "pillOpacity", "miniOpacity", "contentOpacity", "bgFade", "fadeIn"]
        m[id] = m.top.findNode(id)
    end for

    applyLayout()
    buildDock()
    buildInputs()
    buildUtils()
    m.photoName = ""
    m.allApps.relay = m.relay
    m.allApps.grid = m.layout.grid
    m.allApps.observeField("launchApp", "onSheetLaunch")
    m.allApps.observeField("closed", "closeSheet")
    m.allApps.observeField("toggleHome", "onSheetToggle")
    m.settings.relay = m.relay
    m.settings.observeField("closed", "closeSheet")
    m.settings.observeField("changed", "onSettingsChanged")
    reg = CreateObject("roRegistrySection", "home")
    m.wallPin = reg.Read("wallPin")
    m.wallEvery = reg.Read("wallEvery")
    m.bgTop = "A"  ' which background poster is showing
    m.rotateTimer.observeField("fire", "fetchWallpaper")
    m.saverAnim.observeField("state", "onSaverAnimState")
    m.layerAnim.observeField("state", "onLayerAnimState")
    m.bgFade.observeField("state", "onBgFadeState")

    m.zone = "dock"
    m.col = 0
    m.offset = 0
    m.inputCol = savedInput()
    m.utilCol = 0
    m.tiles[0].highlighted = true
    updateFades()

    m.weatherText = ""
    m.status = ""
    m.tasks = {}
    m.clockTimer = m.top.findNode("clockTimer")
    m.clockTimer.observeField("fire", "updateInfo")
    m.clockTimer.control = "start"
    m.statusTimer = m.top.findNode("statusTimer")
    m.statusTimer.observeField("fire", "clearStatus")
    updateInfo()

    m.keyTrap.setFocus(true)

    ' Show the Pi's photo and glass if they arrive quickly, else the bundled set
    m.revealed = false
    m.revealTimer = m.top.findNode("revealTimer")
    m.revealTimer.observeField("fire", "onRevealTimeout")
    if m.relay = "" then
        reveal(false)
    else
        m.revealTimer.control = "start"
        fetchWallpaper()
        setupRotation()
        fetchWeather()
        weatherTimer = m.top.findNode("weatherTimer")
        weatherTimer.observeField("fire", "fetchWeather")
        weatherTimer.control = "start"
    end if
end sub

' ---------------------------------------------------------------- layout

sub applyLayout()
    L = m.layout
    d = L.dock
    m.dockGlass.translation = [d[0], d[1]]
    m.dockGlass.width = d[2]
    m.dockGlass.height = d[3]

    s = L.shelf
    m.shelf.translation = [s[0], s[1]]
    m.shelf.clippingRect = [0, 0, s[2], s[3]]
    m.tileW = L.tile[0]
    m.tileInset = L.tile[2]
    m.plate.width = L.tile[0]
    m.plate.height = L.tile[1]
    m.plate.translation = [0, m.tileInset]
    m.visible = L.visible

    m.fadeL.translation = [d[0], d[1]]
    m.fadeR.translation = [d[0] + d[2] - L.fade, d[1]]
    for each fade in [m.fadeL, m.fadeR]
        fade.width = L.fade
        fade.height = d[3]
    end for

    mn = L.mini
    m.miniGlass.translation = [mn[0], mn[1]]
    m.miniGlass.width = mn[2]
    m.miniGlass.height = mn[3]
    m.tvIcon.width = 36
    m.tvIcon.height = 36
    m.tvIcon.translation = [mn[0] + (mn[2] - 36) / 2, mn[1] + (mn[3] - 36) / 2]

    p = L.pill
    m.pillGlass.translation = [p[0], p[1]]
    m.pillGlass.width = p[2]
    m.pillGlass.height = p[3]
    m.pill.scaleRotateCenter = [p[0] + p[2] / 2, p[1] + p[3] / 2]
    m.collapsedScale = mn[2] / p[2]
    m.pill.scale = [m.collapsedScale, 1.0]

    m.segW = L.segment[0]
    m.segH = L.segment[1]
    m.segPad = L.segment[2]
    m.segPlate.width = m.segW
    m.segPlate.height = m.segH
end sub

sub buildDock()
    m.tiles = []
    for i = 0 to m.apps.Count() - 1
        tile = m.track.createChild("Tile")
        tile.translation = [0, m.tileInset]
        tile.slotX = i * m.tileW
        tile.app = m.apps[i]
        m.tiles.Push(tile)
    end for
end sub

' ---------------------------------------------------------------- dock contents (saved on the TV)

function loadDock(defaults as Object) as Object
    raw = CreateObject("roRegistrySection", "home").Read("dock")
    if raw = "" then return defaults
    saved = ParseJson(raw)
    if saved = invalid or saved.Count() = 0 then return defaults
    apps = []
    for each item in saved
        apps.Push(dockEntry(item.id, item.name))
    end for
    return apps
end function

function dockEntry(id as String, name as String) as Object
    ' Known apps keep their display name and white mark
    if m.catalog[id] <> invalid then return m.catalog[id]
    return { id: id, name: name }
end function

sub saveDock()
    items = []
    for each app in m.apps
        items.Push({ id: app.id, name: app.name })
    end for
    section = CreateObject("roRegistrySection", "home")
    section.Write("dock", FormatJson(items))
    section.Flush()
end sub

function homeIds() as Object
    ids = []
    for each app in m.apps
        ids.Push(app.id)
    end for
    return ids
end function

sub rebuildDock()
    m.track.removeChildren(m.tiles)
    buildDock()
    if m.col >= m.tiles.Count() then m.col = m.tiles.Count() - 1
    m.offset = clampOffset(m.offset)
    m.track.translation = [-m.offset * m.tileW, 0]
    m.plate.translation = [m.col * m.tileW, m.tileInset]
    m.tiles[m.col].highlighted = (m.zone = "dock")
    updateFades()
end sub

function clampOffset(offset as Integer) as Integer
    ' Keep the focused tile visible and don't scroll past the end
    if m.col < offset then offset = m.col
    if m.col >= offset + m.visible then offset = m.col - m.visible + 1
    maxOffset = m.tiles.Count() - m.visible
    if maxOffset < 0 then maxOffset = 0
    if offset > maxOffset then offset = maxOffset
    return offset
end function

sub scrollToFocus()
    offset = clampOffset(m.offset)
    if offset <> m.offset then
        m.offset = offset
        glide(m.trackAnim, m.trackTo, m.track, [-offset * m.tileW, 0])
    end if
    glide(m.plateAnim, m.plateTo, m.plate, [m.col * m.tileW, m.tileInset])
    updateFades()
end sub

' ---------------------------------------------------------------- moving apps in the dock

sub enterMove()
    m.zone = "move"
    m.tiles[m.col].lifted = true
    setStatus("◀ ▶  move  ·  OK  place  ·  ▼  remove from Home", false)
end sub

sub placeTile()
    m.tiles[m.col].lifted = false
    m.tiles[m.col].highlighted = true
    m.plate.opacity = 1.0
    m.zone = "dock"
    saveDock()
    clearStatus()
end sub

function shiftTile(delta as Integer) as Boolean
    target = m.col + delta
    if target < 0 or target >= m.tiles.Count() then return true
    app = m.apps[m.col]
    m.apps[m.col] = m.apps[target]
    m.apps[target] = app
    tile = m.tiles[m.col]
    m.tiles[m.col] = m.tiles[target]
    m.tiles[target] = tile
    m.tiles[m.col].slotX = m.col * m.tileW
    m.tiles[target].slotX = target * m.tileW
    m.col = target
    scrollToFocus()
    return true
end function

sub removeFromDock()
    if m.tiles.Count() <= 1 then
        setStatus("Home needs at least one app", true)
        return
    end if
    name = m.apps[m.col].name
    m.track.removeChild(m.tiles[m.col])
    m.tiles.Delete(m.col)
    m.apps.Delete(m.col)
    for i = m.col to m.tiles.Count() - 1
        m.tiles[i].slotX = i * m.tileW
    end for
    if m.col >= m.tiles.Count() then m.col = m.tiles.Count() - 1
    m.tiles[m.col].highlighted = true
    m.plate.opacity = 1.0
    m.zone = "dock"
    saveDock()
    scrollToFocus()
    setStatus("Removed " + name + " from Home", true)
end sub

sub onSheetToggle()
    app = m.allApps.toggleHome
    index = -1
    for i = 0 to m.apps.Count() - 1
        if m.apps[i].id = app.id then index = i
    end for
    if index >= 0 then
        if m.apps.Count() <= 1 then
            m.allApps.notice = "Home needs at least one app"
            return
        end if
        m.apps.Delete(index)
        m.allApps.notice = "Removed " + app.name + " from Home"
    else
        m.apps.Push(dockEntry(app.id, app.name))
        m.allApps.notice = "Added " + app.name + " to Home"
    end if
    saveDock()
    rebuildDock()
    m.allApps.homeIds = homeIds()
end sub

sub buildInputs()
    m.inputLabels = []
    for i = 0 to m.inputs.Count() - 1
        font = CreateObject("roSGNode", "Font")
        font.uri = "pkg:/fonts/Inter-Medium.ttf"
        font.size = 30
        label = m.pillContent.createChild("Label")
        label.font = font
        label.text = m.inputs[i].name
        label.color = "0xF6F1E7FF"
        label.opacity = 0.84
        label.width = m.segW
        label.height = m.segH
        label.horizAlign = "center"
        label.vertAlign = "center"
        label.translation = segmentPosition(i)
        m.inputLabels.Push(label)
    end for
end sub

function segmentPosition(i as Integer) as Object
    p = m.layout.pill
    return [p[0] + m.segPad + i * m.segW, p[1] + m.segPad]
end function

' ---------------------------------------------------------------- wallpaper

function glassUrl(name as String, rect as Object, fade as String) as String
    url = m.relay + "/glass/" + name.EncodeUriComponent()
    url = url + "?x=" + rect[0].ToStr() + "&y=" + rect[1].ToStr() + "&w=" + rect[2].ToStr() + "&h=" + rect[3].ToStr() + "&r=" + rect[4].ToStr()
    if fade <> "" then url = url + "&fade=" + fade + "&fw=" + m.layout.fade.ToStr()
    return url
end function

sub onWallpaper(result as Object)
    if result = invalid or result.name = invalid then
        reveal(false)
        return
    end if
    L = m.layout
    m.photoName = result.name
    for i = 0 to m.utilItems.Count() - 1
        m.utilItems[i].glass.uri = glassUrl(result.name, L.utils[i].rect, "")
    end for
    m.wallUris = {
        bgB: m.relay + result.photo,
        dockGlass: glassUrl(result.name, L.dock, ""),
        fadeL: glassUrl(result.name, L.dock, "l"),
        fadeR: glassUrl(result.name, L.dock, "r"),
        pillGlass: glassUrl(result.name, L.pill, ""),
        miniGlass: glassUrl(result.name, L.mini, "")
    }
    m.wallPending = {}
    for each id in m.wallUris
        m.wallPending[id] = true
        m[id].observeField("loadStatus", "onWallLoad")
        m[id].uri = m.wallUris[id]
    end for
end sub

sub onWallLoad(event as Object)
    if m.revealed or m.wallPending = invalid then return
    poster = event.getRoSGNode()
    if poster.uri <> m.wallUris[poster.id] then return
    status = poster.loadStatus
    if status = "ready" then
        m.wallPending.Delete(poster.id)
        if m.wallPending.Count() = 0 then reveal(true)
    else if status = "failed" then
        print "[home] couldn't load "; poster.uri
        restoreBundledGlass()
        reveal(false)
    end if
end sub

sub onRevealTimeout()
    if m.revealed then return
    print "[home] wallpaper from the Pi took too long; using the bundled one"
    restoreBundledGlass()
    reveal(false)
end sub

sub restoreBundledGlass()
    m.wallPending = invalid
    m.bgB.uri = ""
    m.dockGlass.uri = "pkg:/images/glass_dock.png"
    m.fadeL.uri = "pkg:/images/glass_fadeL.png"
    m.fadeR.uri = "pkg:/images/glass_fadeR.png"
    m.pillGlass.uri = "pkg:/images/glass_pill.png"
    m.miniGlass.uri = "pkg:/images/glass_mini.png"
    m.photoName = ""
    for i = 0 to m.utilItems.Count() - 1
        m.utilItems[i].glass.uri = m.layout.utils[i].glass
    end for
end sub

sub reveal(withPhoto as Boolean)
    if m.revealed then return
    m.revealed = true
    m.revealTimer.control = "stop"
    ' Without the Pi, the bundled photo (which the bundled glass matches)
    ' replaces the launch screen
    if not withPhoto then m.bgB.uri = "pkg:/images/wallpaper.jpg"
    m.bgTop = "B"
    m.bgFade.control = "start"
    m.fadeIn.control = "start"
end sub

' ---------------------------------------------------------------- data

sub fetch(kind as String, url as String)
    task = CreateObject("roSGNode", "FetchTask")
    task.kind = kind
    task.url = url
    task.observeField("done", "onFetched")
    m.tasks[kind] = task  ' keep a reference until it finishes
    task.control = "run"
end sub

sub fetchWeather()
    fetch("weather", m.relay + "/weather")
end sub

sub onFetched(event as Object)
    task = event.getRoSGNode()
    result = invalid
    if task.code = 200 then result = ParseJson(task.response)
    if task.kind = "wallpaper" then
        if m.revealed then
            changeWallpaper(result)
        else
            onWallpaper(result)
        end if
    else if task.kind = "weather" then
        m.weatherText = ""
        if result <> invalid and result.temp <> invalid then m.weatherText = result.temp.ToStr() + "°  " + result.text
        updateInfo()
    end if
end sub

' ---------------------------------------------------------------- clock / info line

sub updateInfo()
    dt = CreateObject("roDateTime")
    dt.ToLocalTime()
    h12 = dt.GetHours() mod 12
    if h12 = 0 then h12 = 12
    setText(m.clock, m.clockShadow, h12.ToStr() + ":" + Right("0" + dt.GetMinutes().ToStr(), 2))

    text = m.status
    if text = "" then
        months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
        text = dt.GetWeekday() + ", " + months[dt.GetMonth() - 1] + " " + dt.GetDayOfMonth().ToStr()
        if m.weatherText <> "" then text = text + "  ·  " + m.weatherText
    end if
    setText(m.info, m.infoShadow, text)
end sub

sub setText(label as Object, shadow as Object, text as String)
    label.text = text
    shadow.text = text
end sub

sub showStatus(text as String)
    setStatus(text, true)
end sub

sub setStatus(text as String, timed as Boolean)
    m.status = text
    updateInfo()
    m.statusTimer.control = "stop"
    if timed then m.statusTimer.control = "start"
end sub

sub clearStatus()
    m.status = ""
    updateInfo()
end sub

' ---------------------------------------------------------------- dock

function moveDock(delta as Integer) as Boolean
    target = m.col + delta
    if target < 0 or target >= m.tiles.Count() then return true
    m.tiles[m.col].highlighted = false
    m.col = target
    m.tiles[m.col].highlighted = true
    scrollToFocus()
    return true
end function

sub glide(anim as Object, interp as Object, node as Object, target as Object)
    anim.control = "stop"
    interp.keyValue = [node.translation, target]
    anim.control = "start"
end sub

sub updateFades()
    m.fadeL.opacity = 0.0
    m.fadeR.opacity = 0.0
    if m.offset > 0 then m.fadeL.opacity = 1.0
    if m.offset + m.visible < m.tiles.Count() then m.fadeR.opacity = 1.0
end sub

' ---------------------------------------------------------------- inputs pill

sub enterInputs()
    if m.inputs.Count() = 0 then return
    m.zone = "inputs"
    m.tiles[m.col].highlighted = false
    m.plate.opacity = 0.12  ' a faint trace of where you came from
    m.segPlate.translation = segmentPosition(m.inputCol)
    highlightInput()
    animatePill(true)
end sub

sub leaveInputs()
    m.zone = "dock"
    m.plate.opacity = 1.0
    m.tiles[m.col].highlighted = true
    animatePill(false)
end sub

sub animatePill(open as Boolean)
    m.pillAnim.control = "stop"
    full = [1.0, 1.0]
    closed = [m.collapsedScale, 1.0]
    if open then
        ' Stretch out past full width, then settle; text appears once it's wide
        m.pillAnim.duration = 0.36
        m.pillScale.key = [0.0, 0.7, 1.0]
        m.pillScale.keyValue = [m.pill.scale, [1.03, 1.0], full]
        m.pillOpacity.key = [0.0, 0.2, 1.0]
        m.pillOpacity.keyValue = [m.pill.opacity, 1.0, 1.0]
        m.miniOpacity.key = [0.0, 0.2, 1.0]
        m.miniOpacity.keyValue = [m.mini.opacity, 0.0, 0.0]
        m.contentOpacity.key = [0.0, 0.5, 1.0]
        m.contentOpacity.keyValue = [m.pillContent.opacity, m.pillContent.opacity, 1.0]
    else
        m.pillAnim.duration = 0.26
        m.pillScale.key = [0.0, 1.0]
        m.pillScale.keyValue = [m.pill.scale, closed]
        m.pillOpacity.key = [0.0, 0.75, 1.0]
        m.pillOpacity.keyValue = [m.pill.opacity, m.pill.opacity, 0.0]
        m.miniOpacity.key = [0.0, 0.6, 1.0]
        m.miniOpacity.keyValue = [m.mini.opacity, m.mini.opacity, 1.0]
        m.contentOpacity.key = [0.0, 0.3, 1.0]
        m.contentOpacity.keyValue = [m.pillContent.opacity, 0.0, 0.0]
    end if
    m.pillAnim.control = "start"
end sub

function moveInput(delta as Integer) as Boolean
    target = m.inputCol + delta
    if target < 0 or target >= m.inputs.Count() then return true
    m.inputCol = target
    glide(m.segAnim, m.segTo, m.segPlate, segmentPosition(target))
    highlightInput()
    return true
end function

sub highlightInput()
    for i = 0 to m.inputLabels.Count() - 1
        m.inputLabels[i].opacity = 0.84
    end for
    m.inputLabels[m.inputCol].opacity = 1.0
end sub

function savedInput() as Integer
    value = CreateObject("roRegistrySection", "home").Read("input")
    if value = "" then return 0
    i = value.ToInt()
    if i < 0 or i >= m.inputs.Count() then return 0
    return i
end function

sub saveInput()
    section = CreateObject("roRegistrySection", "home")
    section.Write("input", m.inputCol.ToStr())
    section.Flush()
end sub

' ---------------------------------------------------------------- top-right controls

sub buildUtils()
    m.utilItems = []
    for i = 0 to m.layout.utils.Count() - 1
        u = m.layout.utils[i]
        r = u.rect
        cx = r[0] + r[2] / 2
        item = m.utils.createChild("Group")
        glass = item.createChild("Poster")
        glass.id = "utilGlass" + i.ToStr()
        glass.uri = u.glass
        glass.translation = [r[0], r[1]]
        glass.width = r[2]
        glass.height = r[3]
        glass.opacity = 0
        icon = item.createChild("Poster")
        icon.id = "utilIcon" + i.ToStr()
        icon.uri = u.icon
        icon.width = 36
        icon.height = 36
        icon.translation = [cx - 18, r[1] + (r[3] - 36) / 2]
        icon.opacity = 0.66
        font = CreateObject("roSGNode", "Font")
        font.uri = "pkg:/fonts/Inter-Medium.ttf"
        font.size = 26
        label = item.createChild("Label")
        label.id = "utilLabel" + i.ToStr()
        label.font = font
        label.text = u.label
        label.color = "0xF6F1E7FF"
        label.width = 260
        label.horizAlign = "center"
        label.translation = [cx - 130, r[1] + r[3] + 12]
        label.opacity = 0

        anim = m.top.createChild("Animation")
        anim.duration = 0.2
        anim.easeFunction = "outCubic"
        interps = {}
        for each part in ["Glass", "Icon", "Label"]
            interp = anim.createChild("FloatFieldInterpolator")
            interp.key = [0.0, 1.0]
            interp.fieldToInterp = "util" + part + i.ToStr() + ".opacity"
            interps[part] = interp
        end for
        m.utilItems.Push({ glass: glass, icon: icon, label: label, anim: anim, interps: interps })
    end for
end sub

sub highlightUtil(i as Integer, on as Boolean)
    item = m.utilItems[i]
    glass = 0.0
    icon = 0.66
    label = 0.0
    if on then
        glass = 1.0
        icon = 1.0
        label = 1.0
    end if
    item.anim.control = "stop"
    item.interps.Glass.keyValue = [item.glass.opacity, glass]
    item.interps.Icon.keyValue = [item.icon.opacity, icon]
    item.interps.Label.keyValue = [item.label.opacity, label]
    item.anim.control = "start"
end sub

sub enterUtils()
    if m.utilItems.Count() = 0 then return
    m.zone = "utils"
    m.tiles[m.col].highlighted = false
    m.plate.opacity = 0.12  ' a faint trace of where you came from
    highlightUtil(m.utilCol, true)
end sub

sub leaveUtils()
    highlightUtil(m.utilCol, false)
    m.zone = "dock"
    m.plate.opacity = 1.0
    m.tiles[m.col].highlighted = true
end sub

function moveUtil(delta as Integer) as Boolean
    target = m.utilCol + delta
    if target < 0 or target >= m.utilItems.Count() then return true
    highlightUtil(m.utilCol, false)
    m.utilCol = target
    highlightUtil(m.utilCol, true)
    return true
end function

sub runUtil(action as String)
    if action = "apps" then openSheet(m.allApps)
    if action = "saver" then openSaver()
    if action = "settings" then openSheet(m.settings)
end sub

' ---------------------------------------------------------------- All apps sheet

sub openSheet(sheet as Object)
    m.zone = "sheet"
    m.sheet = sheet
    sheet.photo = m.photoName
    if sheet.id = "allApps" then sheet.homeIds = homeIds()
    sheet.visible = true
    sheet.opened = true
    sheet.setFocus(true)
    swapLayer(true)
end sub

sub closeSheet()
    m.zone = "utils"
    m.sheet.setFocus(false)
    m.keyTrap.setFocus(true)
    swapLayer(false)
end sub

sub onLayerAnimState()
    ' Fully hide the sheet once it has faded out
    if m.layerAnim.state = "stopped" and m.zone <> "sheet" and m.sheet <> invalid then
        m.sheet.visible = false
        m.sheet.released = true
    end if
end sub

sub swapLayer(showSheet as Boolean)
    m.layerAnim.control = "stop"
    target = 0.0
    if showSheet then target = 1.0
    m.layerContent.keyValue = [m.content.opacity, 1.0 - target]
    ' Only the sheet being opened or closed changes
    m.layerSheet.keyValue = [m.allApps.opacity, m.allApps.opacity]
    m.layerSettings.keyValue = [m.settings.opacity, m.settings.opacity]
    if m.sheet.id = "allApps" then m.layerSheet.keyValue = [m.allApps.opacity, target]
    if m.sheet.id = "settings" then m.layerSettings.keyValue = [m.settings.opacity, target]
    m.layerAnim.control = "start"
end sub

' ---------------------------------------------------------------- wallpaper changes

function wallpaperUrl() as String
    url = m.relay + "/wallpaper"
    if m.wallPin <> "" then url = url + "?pin=" + m.wallPin.EncodeUriComponent()
    return url
end function

sub fetchWallpaper()
    fetch("wallpaper", wallpaperUrl())
end sub

sub setupRotation()
    m.rotateTimer.control = "stop"
    if m.wallPin <> "" or m.relay = "" then return
    if m.wallEvery = "15" then m.rotateTimer.duration = 15 * 60
    if m.wallEvery = "60" then m.rotateTimer.duration = 60 * 60
    if m.wallEvery = "15" or m.wallEvery = "60" then m.rotateTimer.control = "start"
end sub

sub onSettingsChanged()
    changed = m.settings.changed
    pinChanged = (changed.pin <> m.wallPin)
    m.wallPin = changed.pin
    m.wallEvery = changed.every
    setupRotation()
    if pinChanged then fetchWallpaper()
end sub

' Load the next photo and all of its glass off screen, then crossfade
sub changeWallpaper(result as Object)
    if result = invalid or result.name = invalid or result.name = m.photoName then return
    L = m.layout
    hidden = m.bgB
    if m.bgTop = "B" then hidden = m.bgA
    m.next = { name: result.name, bg: hidden, bgUri: m.relay + result.photo, glass: {
        dockGlass: glassUrl(result.name, L.dock, ""),
        fadeL: glassUrl(result.name, L.dock, "l"),
        fadeR: glassUrl(result.name, L.dock, "r"),
        pillGlass: glassUrl(result.name, L.pill, ""),
        miniGlass: glassUrl(result.name, L.mini, "")
    }, utils: [] }
    for i = 0 to m.utilItems.Count() - 1
        m.next.utils.Push(glassUrl(result.name, L.utils[i].rect, ""))
    end for

    m.preload.removeChildren(m.preload.getChildren(-1, 0))
    m.nextPending = 0
    uris = [m.next.bgUri]
    for each id in m.next.glass
        uris.Push(m.next.glass[id])
    end for
    uris.Append(m.next.utils)
    for each uri in uris
        poster = m.preload.createChild("Poster")
        poster.observeField("loadStatus", "onNextLoad")
        poster.uri = uri
        m.nextPending = m.nextPending + 1
    end for
end sub

sub onNextLoad(event as Object)
    if m.next = invalid then return
    status = event.getRoSGNode().loadStatus
    if status = "failed" then
        m.next = invalid  ' keep the current photo
        return
    end if
    if status <> "ready" then return
    m.nextPending = m.nextPending - 1
    if m.nextPending > 0 then return

    ' Everything is cached now: swap the glass and crossfade the photo
    n = m.next
    m.next = invalid
    bg = n.bg
    bg.uri = n.bgUri
    for each id in n.glass
        m[id].uri = n.glass[id]
    end for
    for i = 0 to m.utilItems.Count() - 1
        m.utilItems[i].glass.uri = n.utils[i]
    end for
    m.photoName = n.name
    ' bgB sits on top: fade it in to show it, or out to reveal bgA
    m.bgFade.control = "stop"
    m.bgFade.duration = 1.2
    if bg.id = "bgB" then
        m.bgFadeTo.keyValue = [m.bgB.opacity, 1.0]
        m.bgTop = "B"
    else
        m.bgFadeTo.keyValue = [m.bgB.opacity, 0.0]
        m.bgTop = "A"
    end if
    m.bgFade.control = "start"
end sub

sub onSheetLaunch()
    launch(m.allApps.launchApp)
end sub

' ---------------------------------------------------------------- screensaver

sub openSaver()
    if m.saver <> invalid then return
    m.zone = "saver"
    m.closingSaver = false
    m.saver = m.saverLayer.createChild("PhotoFrame")
    m.saver.first = m.photoName
    m.saverAnim.control = "stop"
    m.saverAnim.duration = 0.8
    m.saverFade.keyValue = [m.saverLayer.opacity, 1.0]
    m.saverAnim.control = "start"
end sub

sub closeSaver()
    if m.saver = invalid or m.closingSaver then return
    m.closingSaver = true
    m.saverAnim.control = "stop"
    m.saverAnim.duration = 0.4
    m.saverFade.keyValue = [m.saverLayer.opacity, 0.0]
    m.saverAnim.control = "start"
end sub

sub onSaverAnimState()
    if m.saverAnim.state <> "stopped" or m.saver = invalid or not m.closingSaver then return
    m.saver.active = false
    m.saverLayer.removeChild(m.saver)
    m.saver = invalid
    m.closingSaver = false
    m.zone = "utils"
end sub

' ---------------------------------------------------------------- launching

sub launch(item as Object)
    m.launching = item
    m.launchTask = CreateObject("roSGNode", "LaunchTask")
    m.launchTask.observeField("result", "onLaunchResult")
    m.launchTask.appId = item.id
    m.launchTask.relay = m.relay
    m.launchTask.control = "run"
end sub

sub onLaunchResult()
    code = m.launchTask.result
    if code = 200 or code = 204 then return
    detail = code.ToStr()
    if code = -3 then detail = "no watcher configured"
    if code = -2 or code = -1 then detail = "Pi not reachable"
    showStatus("Couldn't open " + m.launching.name + " (" + detail + ")")
end sub

sub onLaunchReason()
    print "[home] launched with reason="; m.top.launchReason
end sub

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press then return false
    if m.zone = "saver" then
        ' Any key wakes Home back up
        closeSaver()
        return true
    end if
    if m.zone = "sheet" then return true
    if m.zone = "move" then
        if key = "right" then return shiftTile(1)
        if key = "left" then return shiftTile(-1)
        if key = "down" then
            removeFromDock()
            return true
        end if
        if key = "OK" or key = "back" or key = "options" then placeTile()
        return true
    end if
    if m.zone = "utils" then
        if key = "right" then return moveUtil(1)
        if key = "left" then return moveUtil(-1)
        if key = "down" or key = "back" then
            leaveUtils()
            return true
        end if
        if key = "OK" then runUtil(m.layout.utils[m.utilCol].action)
        return true
    end if
    if m.zone = "dock" then
        if key = "right" then return moveDock(1)
        if key = "left" then return moveDock(-1)
        if key = "down" then
            enterInputs()
            return true
        end if
        if key = "up" then
            enterUtils()
            return true
        end if
        if key = "options" then
            enterMove()
            return true
        end if
        if key = "OK" then
            launch(m.apps[m.col])
            return true
        end if
    else
        if key = "right" then return moveInput(1)
        if key = "left" then return moveInput(-1)
        if key = "up" or key = "back" then
            leaveInputs()
            return true
        end if
        if key = "OK" then
            saveInput()
            launch(m.inputs[m.inputCol])
            return true
        end if
    end if
    ' This is the home screen, so Back has nowhere to go
    if key = "back" then return true
    return false
end function

' Once a background crossfade finishes, the covered poster (the launch screen
' or the previous photo) and the preloaded copies only cost image memory
sub onBgFadeState()
    if m.bgFade.state <> "stopped" then return
    if m.bgTop = "B" then
        m.bgA.uri = ""
    else
        m.bgB.uri = ""
    end if
    m.preload.removeChildren(m.preload.getChildren(-1, 0))
end sub
